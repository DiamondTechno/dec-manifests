<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="github"      fetch="https://github.com"/>
  <remote name="oe"          fetch="http://git.openembedded.org"/>
  <remote name="OpenSTLinux" fetch="https://github.com/STMicroelectronics"/>
  <remote name="dec"         fetch="https://github.com/DiamondTechno"/>

  <default remote="OpenSTLinux"/>

  <!--
    OpenEmbedded / Yocto base + ST OpenSTLinux v25.06.11 (scarthgap, kernel 6.6.78)
    SRCREVs match what was in the upstream cargt-stm32mp2.xml manifest at the
    time meta-dec-stm32 was forked.
  -->
  <project name="bitbake" path="layers/openembedded-core/bitbake" remote="oe"
           revision="7375d32e8c1af20c51abec4eb3b072b4ca58b239"/>
  <project name="openembedded-core" path="layers/openembedded-core" remote="oe"
           revision="cd2b6080a4c0f2ed2c9939ec0b87763aef595048"/>
  <project name="meta-openembedded" path="layers/meta-openembedded" remote="oe"
           revision="e92d0173a80ea7592c866618ef5293203c50544c"/>

  <project name="meta-st-openstlinux"   path="layers/meta-st/meta-st-openstlinux"
           revision="14bbb30d00473973a67d85cbb1db8a87aa8afe65"/>
  <project name="meta-st-stm32mp"       path="layers/meta-st/meta-st-stm32mp"
           revision="8b449a5ffe02a4622a1d404ede53ea9a5e6303d6"/>
  <project name="meta-st-stm32mp-addons" path="layers/meta-st/meta-st-stm32mp-addons"
           revision="40ddfa3c88b8d5e27983761f94f1e1ce3653e97d"/>
  <project name="meta-st-scripts"       path="layers/meta-st/scripts"
           revision="8826802b453ef2ead61b07c7bc5ab525a405df04"/>

  <!--
    Diamond Technologies layers + working trees for the STM32MP25 DEC kit.
    No dependency on meta-st-cargt or meta-cargt-stm32mp-addons — all
    STM32MP25-DEC-specific BSP plumbing lives in meta-dec-stm32.
  -->
  <project remote="dec" name="meta-dec-common" path="layers/meta-dec-common"
           revision="7ea45a3b7153dc0228da25fa14df3191538816ff"
           upstream="dec-scarthgap-6.6"/>
  <project remote="dec" name="meta-dec-stm32"  path="layers/meta-dec-stm32"
           revision="24b84382fc464db8b39ed006f3e0e9486416a397"
           upstream="main">
    <linkfile src="scripts/setup_dec_stm32.sh" dest="setup_dec_stm32.sh"/>
  </project>

  <!--
    Kernel + u-boot are built via Yocto's externalsrc class against these
    working trees, so changes you push to these branches are picked up
    on the next bitbake without going through the recipe's fetch step.
    EXTERNALSRC paths in the build dir's local.conf reference these
    locations as ${TOPDIR}/../sources/{linux-stm32,uboot-stm32}.
  -->
  <project remote="dec" name="linux-stm32"  path="sources/linux-stm32"
           revision="ad52170a1950baaebbe56e0c693468dee60cae7a"
           upstream="stm32mp-dec-kit"/>
  <project remote="dec" name="u-boot-stm32" path="sources/uboot-stm32"
           revision="4efd8a64b54b46811c1583d0f7df2b6aaf199e7a"
           upstream="stm32mp-dec-kit"/>

</manifest>
